--=====================================================================
local antiSitEnabled = true
local lastSitWarn = 0

local function isSeat(p)
    return p and (p:IsA("Seat") or p:IsA("VehicleSeat"))
end

local function sitWarn()
    if tick() - lastSitWarn < 3 then return end
    lastSitWarn = tick()
    notify("🚫 กันนั่ง", "เซิร์ฟเวอร์นี้ไม่อนุญาตให้นั่งเก้าอี้", 2)
end

local function forceStand(character, humanoid)
    local seat = humanoid.SeatPart
    if seat then
        for _, v in ipairs(seat:GetChildren()) do
            if v:IsA("Weld") or v:IsA("Motor6D") or v:IsA("WeldConstraint") then
                if v.Name == "SeatWeld" or v:IsA("Weld") then pcall(function() v:Destroy() end) end
            end
        end
    end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Weld") or v:IsA("Motor6D") then
            if isSeat(v.Part0) or isSeat(v.Part1) then pcall(function() v:Destroy() end) end
        end
    end
    humanoid.Sit = false
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
end

local function setupAntiSit(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    character.ChildAdded:Connect(function(child)
        if not antiSitEnabled or not alive() then return end
        if child:IsA("Weld") or child:IsA("Motor6D") then
            task.spawn(function()
                task.wait()
                if isSeat(child.Part0) or isSeat(child.Part1) then
                    pcall(function() child:Destroy() end)
                    humanoid.Sit = false
                    sitWarn()
                end
            end)
        end
    end)

    humanoid.StateChanged:Connect(function(_, newState)
        if not antiSitEnabled or not alive() then return end
        if newState == Enum.HumanoidStateType.Seated then
            forceStand(character, humanoid)
            sitWarn()
        end
    end)

    task.spawn(function()
        while alive() and character and character.Parent and humanoid and humanoid.Parent do
            if antiSitEnabled and (humanoid.Sit or humanoid.SeatPart) then
                forceStand(character, humanoid)
                sitWarn()
            end
            task.wait(0.1)
        end
    end)
end

