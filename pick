--=====================================================================
--  ตัวช่วยตรวจผล / รีเช็กสถานะ (กันซื้อก่อนถอนเสร็จ และไม่หยุดเองเมื่อซื้อไม่ได้)
--=====================================================================
local function waitFor(cond, timeout)
    local t = 0
    while t < timeout do
        if not alive() then return false end
        if cond() then return true end
        task.wait(0.25); t = t + 0.25
    end
    return cond()
end

-- ถอนเงินจนเงินสดถึง target จริง (ตรวจจากเงินสดที่เพิ่ม ไม่ใช่แค่ยิง remote)
local function ensureCash(target)
    for attempt = 1, 4 do
        local cash = getCash()
        if cash >= target then return true end
        local need = target - cash
        if getBank() < need then
            warn(("[AutoFish] ธนาคารมี $%d ไม่พอถอน $%d"):format(getBank(), need))
            return false
        end
        setStatus(("🏦 ถอนเงิน $%d (ครั้งที่ %d/4)"):format(need, attempt), Color3.fromRGB(150, 200, 245))
        pcall(function() ATMRemote:FireServer("Withdraw", need) end)
        if waitFor(function() return getCash() >= target end, 4) then
            print("[AutoFish] ✅ ถอนเงินสำเร็จ เงินสด =", getCash())
            return true
        end
        warn("[AutoFish] ⚠️ ถอนแล้วเงินสดยังไม่เพิ่ม ลองใหม่")
    end
    return getCash() >= target
end

-- เหยื่อที่ใช้ตัดสินใจ: ถ้านับจากกระเป๋าไม่เจอ แต่เงินลดจริง ใช้จำนวนที่ซื้อแทน
local function getEffectiveBait()
    local real = getBaitCount()
    if real > 0 then baitBlind = 0; return real end
    return baitBlind
end

-- รีเช็ก: ซิงก์กระเป๋า อ่านเงิน/เหยื่อ/เบ็ดใหม่ แล้วค่อยให้ลูปตัดสินใจต่อ
local function resyncState(reason, extraWait)
    setStatus("🔄 รีเช็กสถานะ: " .. reason, Color3.fromRGB(255, 200, 80))
    pcall(function() ItemsEvent:FireServer("Sync") end)
    task.wait(2)
    if hasRod() then rodOwned = true end
    baitFailCount = 0
    rodFailStreak = 0
    print(("[AutoFish] 🔎 เช็ก: เงินสด=%d ธนาคาร=%d เหยื่อ=%d มีเบ็ด=%s ถือเบ็ด=%s")
        :format(getCash(), getBank(), getBaitCount(), tostring(hasRod()), tostring(heldRod() and true or false)))
    notify("🔄 รีเช็กสถานะ", reason, 3)
    if extraWait and extraWait > 0 then
        for i = extraWait, 1, -1 do
            if not (running or manualTest) or not alive() then return end
            task.wait(1)
        end
    end
end

local function printCheck(tag)
    print(("[AutoFish] 🔎 [%s] เงินสด=%d ธนาคาร=%d เหยื่อ=%d มีเบ็ด=%s ถือเบ็ด=%s ตั๋ว=%s")
        :format(tag, getCash(), getBank(), getBaitCount(), tostring(hasRod()), tostring(heldRod() and true or false), tostring(hasPalmTicket())))
