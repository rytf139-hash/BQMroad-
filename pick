local function fmt(n)
    local str = tostring(math.floor(n))
    local left, num, right = str:match("^([^%d]*%d)(%d*)(.-)$")
    if not left then return str end
    local rev = num:reverse():gsub("(%d%d%d)", "%1,")
    return left .. rev:reverse() .. right
end

