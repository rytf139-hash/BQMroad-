local function getBaitCount()
    local n = 0
    for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool")
                    and t:GetAttribute("MD_FarmItem") == true
                    and t.Name:lower():find(CFG.BAIT_MATCH, 1, true) then
                    n = n + (tonumber(t:GetAttribute("MD_StackCount")) or 1)
                end
            end
        end
    end
    return n
end

local function pickZone(lv)
    local z = ZONES[1]
    for _, zz in ipairs(ZONES) do
        if lv >= zz.minLv then z = zz end
    end
    return z
end

