do
    local USER = env.AutoFishConfig
    local function pick(key, lo, hi)
        if type(USER) ~= "table" or USER[key] == nil then return end
        local v = tonumber(USER[key])
        if not v then
            warn("[AutoFish] คอนฟิก " .. key .. " ไม่ใช่ตัวเลข ใช้ค่าเดิม " .. tostring(CFG[key]))
            return
        end
        CFG[key] = math.clamp(math.floor(v), lo, hi)
    end
    pick("TARGET_MONEY", 1, 100000000)
    pick("DEPOSIT_AT",   1, 100000000)
    pick("BAIT_COUNT",   1, 500)
    pick("SPEED",        16, 400)
    pick("PALM_LEVEL",   1, 500)           -- เลเวลตกปลาที่เริ่มไป Palm Island (ปกติ 60)
    pick("TICKET_MONEY", 1, 1000000000)    -- เงินรวมที่ต้องมีก่อนซื้อตั๋ว (ปกติ 2,200,000)
    if type(USER) == "table" and USER.PALM_NEED_LEVEL ~= nil then
        CFG.PALM_NEED_LEVEL = (USER.PALM_NEED_LEVEL == true)
    end
    -- บังคับว่ามีตั๋วแล้ว (ใช้เมื่อสคริปต์เช็กไม่เจอ แต่คุณซื้อไปแล้วจริง)
