--// ========== Steps ==========
local function stepAccept()
    if shiftStarted then return true end

    setStatus("🚶 ไปจุดรับงาน (speed " .. SPEED_BEFORE .. ")")
    tweenWalk(POS_ACCEPT, SPEED_BEFORE)
    task.wait(0.3)

    setStatus("🔵 กดรับงาน (ครั้งเดียว)...")
    pressShiftOnce()

    -- รอ Feedback จริงจาก server
    local t = 0
    while running and alive() and not shiftStarted and t < ACCEPT_TIMEOUT do
        task.wait(0.1)
        t = t + 0.1
    end

    if not shiftStarted then
        setStatus("⚠️ server ยังไม่ตอบ จะลองใหม่", Color3.fromRGB(255,200,80))
    end
    return shiftStarted
end

local function stepFridge()
    steakReady = false
    -- เดิน/วาร์ปเข้าจุดตู้เย็นเสมอ (ถ้ายืนอยู่แล้วฟังก์ชันจะแค่ snap ตำแหน่ง ไม่เสียเวลา)
    setStatus("🚶 ไปตู้เย็น (speed " .. CFG.SPEED .. ")")
    tweenWalk(POS_FRIDGE, CFG.SPEED)
    task.wait(0.3)

    setStatus("🧊 กด MD_CookFridge")
    for i = 1, 5 do
        if not running then return end
        interact(getFridgeObj(), "MD_CookFridge")
        task.wait(0.4)
        if steakReady then break end   -- server ตอบ "Steak ready" แล้ว ไม่ต้องกดซ้ำ
    end
    if steakReady then
        print("[AutoCook] ✅ หยิบสเต็กแล้ว")
    else
        warn("[AutoCook] ⚠️ ไม่ได้รับ 'Steak ready' จาก server (ไปต่อตามเดิม)")
    end
    task.wait(0.2)
end

local function stepGrill()
    grillStarted = false
    grillInfo = nil
    setStatus("🚶 ไปเตาย่าง (speed " .. CFG.SPEED .. ")")
    tweenWalk(POS_GRILL, CFG.SPEED)
    task.wait(0.3)
    local hrp = getHRP()

    -- "Take it to a free grill": ลองเตาที่ใกล้สุดก่อน ถ้า server ไม่ตอบ Start ค่อยลองเตาถัดไป (สูงสุด 3 เตา)
    local list = getGrillList()
    if #list == 0 then
        local g = getGrillObj()
        if g then list = { { obj = g, pos = POS_GRILL, dist = -1 } } else warn("[AutoCook] ❌ ไม่เจอเตาเลย") end
    end

    setStatus("🔥 กด MD_CookGrill")
    for idx, entry in ipairs(list) do
        if idx > 3 or grillStarted or not running or not hrp then break end
        local grill = entry.obj
        print(("[AutoCook] เตา #%d: %s [%s] ห่าง POS_GRILL %.1f studs"):format(idx, grill:GetFullName(), grill.ClassName, entry.dist))
        local base = (idx == 1) and POS_GRILL or Vector3.new(entry.pos.X, POS_GRILL.Y, entry.pos.Z)

        for i = 1, 4 do
            if not running or grillStarted then break end
            pcall(function() hrp.CFrame = CFrame.new(base + Vector3.new(0,0,1.5)) end)
            task.wait(0.15)
            pcall(function() hrp.CFrame = CFrame.new(base + Vector3.new(0,0,-1.5)) end)
            task.wait(0.15)
            if not grill or not grill.Parent then grill = getGrillObj() end
            interact(grill, "MD_CookGrill")
            task.wait(0.35)   -- รอ server ตอบ Start
        end
    end

    if grillStarted then
        print("[AutoCook] ✅ วางสเต็กบนเตาแล้ว")
    else
        warn("[AutoCook] ⚠️ ไม่ได้รับ Start จาก server (ใช้เวลารอสำรอง)")
    end
    task.wait(0.3)
end

local function stepCook()
    -- วางสเต็กเสร็จ → ไปรอหน้าตู้เย็นทันที
    setStatus("🚶 กลับไปรอหน้าตู้เย็น")
    tweenWalk(POS_FRIDGE, CFG.SPEED)

    -- รอให้ครบเวลาย่างตามที่ server บอก (Start) ถ้าไม่ได้รับ ใช้ WAIT_BEFORE_REMOTE
    local total  = grillInfo and grillInfo.dur or CFG.WAIT_BEFORE_REMOTE
    local from   = grillInfo and grillInfo.recv or tick()
    local target = from + total + CFG.COOK_EXTRA
    local shown  = nil
    while running and alive() and tick() < target do
        local left = math.ceil(target - tick())
        if left ~= shown then
            shown = left
            setStatus(("⏳ รอสเต็กสุก %d วิ ก่อนยิงรีโมท..."):format(left), Color3.fromRGB(255,200,80))
        end
        task.wait(0.2)
    end
    if not running then return end

    setStatus("🔥 Finish (ยิง MD_CookRemote)")
    pcall(function() if CookRemote then CookRemote:FireServer("Finish") end end)
    task.wait(0.2)
    for _, a in ipairs({"finish_grilling_2","Finish","finish"}) do
        pcall(function() if CookRemote then CookRemote:FireServer(a) end end)
    end
    task.wait(0.3)
    pcall(function()
        if firesignal and CookRemote then
            firesignal(CookRemote.OnClientEvent, "Finished", "Perfect!", 160, 26)
        end
        if firesignal and CashFX then
            firesignal(CashFX.OnClientEvent, "Pickup", 160)
        end
    end)
    task.wait(CFG.AFTER_FINISH_WAIT)
end

-- ทำสเต็ก 1 รอบ (เหมือน 1 ลูปของ mainLoop ในสคริปต์ฟามสเต็กเดิม)
local function cookOnce()
    if not shiftStarted then
        if not stepAccept() then
            task.wait(1); return
        end
    end
    if not running then return end
    stepFridge()
    if not running then return end
    stepGrill()
    if not running then return end
    stepCook()
    task.wait(0.1)
end

