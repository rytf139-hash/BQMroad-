        if hasRod() or getCash() <= before - 1000 then return true end
        -- ยังไม่ผ่าน: ยืนที่เดิมต่ออีกหน่อย (ห้ามขยับ เดี๋ยวเวลายืนรอรีเซ็ต) แล้วลองใหม่
