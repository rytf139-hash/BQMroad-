local function refresh()
    local cash, bank, bait = getCash(), getBank(), getBaitCount()
    local lv = getFishLevel()

    vCash.Text  = "$" .. fmt(cash)
    vBank.Text  = "$" .. fmt(bank)
    vBait.Text  = tostring(bait)
    vFish.Text  = tostring(getFishCount())
    vLevel.Text = "Lv " .. lv
    vCatch.Text = tostring(catchCount)
    badgeText.Text = "🎣 Fishing Lv " .. lv

    local haveRod = rodOwned or hasRod()
    if haveRod and (lv >= CFG.PALM_LEVEL or hasPalmTicket()) then
        -- เลเวล 60+: แถบเงินเปลี่ยนเป็นเป้าหมายตั๋ว Palm Island
        if hasPalmTicket() then
            setMoneyBar("✅ มีตั๋วแล้ว", 1, "🎫 ตั๋ว Palm Island")
        else
            local total = cash + bank
            setMoneyBar(("$%s / $%s"):format(fmt(total), fmt(CFG.TICKET_MONEY)),
                total / math.max(CFG.TICKET_MONEY, 1), "🎫 เป้าหมายตั๋ว Palm")
        end
    elseif haveRod then
        setMoneyBar("✅ ได้เบ็ดแล้ว", 1, "💰 เป้าหมายซื้อเบ็ด")
    else
        local total = cash + bank
        local ratio = total / math.max(CFG.TARGET_MONEY, 1)
        setMoneyBar(("$%s / $%s"):format(fmt(total), fmt(CFG.TARGET_MONEY)), ratio, "💰 เป้าหมายซื้อเบ็ด")
    end
    setBaitBar(("%d / %d"):format(bait, CFG.BAIT_COUNT), bait / math.max(CFG.BAIT_COUNT, 1))

    local info = PHASES[phase] or PHASES.IDLE
    local text, color = info[1], info[2]
    if not running then
        text, color = "⏸ หยุดชั่วคราว", C.MUTED
    elseif phase == "FISH" and curZone then
        text = "🎣 ตกปลา · " .. curZone.name
    end
    phaseLabel.Text = text
    phaseLabel.TextColor3 = color
    mainStroke.Color = color
    avatarStroke.Color = color
    pauseBtn.Text = running and "⏸" or "▶"

    -- สถานะตั๋ว Palm Island + ข้อความล่าสุดจาก server ตอนตกปลา (บอกสาเหตุถ้าโยนไม่ติด)
    local tState
    if hasPalmTicket() then
        tState = "✔ มีแล้ว (" .. ticketSource .. ")"
    elseif ticketListed then
        tState = "✘ ยังไม่มี"
    elseif ticketChecked then
        tState = "? เช็กไม่ได้"
    else
        tState = "… ยังไม่เช็ก"
    end
    cfgLabel.Text = ("🎫 ตั๋ว Palm: %s  •  Lv %d  •  server: %s")
        :format(tState, lv, lastFishMsg ~= "" and lastFishMsg:sub(1, 48) or "-")
    afkLabel.Text = afkPings > 0 and ("🛡 Anti-AFK: ON (กันแล้ว %d)"):format(afkPings) or "🛡 Anti-AFK: ON"
    local up = os.time() - startClock
    uptimeLabel.Text = ("⏱ %02d:%02d:%02d"):format(math.floor(up / 3600), math.floor(up / 60) % 60, up % 60)
end

