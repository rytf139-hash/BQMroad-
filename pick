local function setRunning(state)
    running = state and true or false
    if running then
        if not loopActive then
            loopActive = true
            task.spawn(function() pcall(mainLoop); loopActive = false end)
        end
    else
        if activeTween then pcall(function() activeTween:Cancel() end) end
        if activeBeam and activeBeam.Parent then activeBeam:Destroy() end
        setStatus("⏸ หยุดชั่วคราว", C.MUTED)
    end
end
pauseBtn.MouseButton1Click:Connect(function() setRunning(not running) end)

local startClock = os.time()

local function refresh()
    local cash, bank, bait = getCash(), getBank(), getBaitCount()
    local lv = getFishLevel()

    vCash.Text  = "$" .. fmt(cash)
    vBank.Text  = "$" .. fmt(bank)
    vBait.Text  = tostring(bait)
    vFish.Text  = tostring(getFishCount())
    vLevel.Text = "Lv " .. lv
    vCatch.Text = tostring(catchCount)
    badgeText.Text = "🎣 Fishing Lv " .. lv

    if rodOwned or hasRod() then
        setMoneyBar("✅ ได้เบ็ดแล้ว", 1)
    else
        local total = cash + bank
        local ratio = total / math.max(CFG.TARGET_MONEY, 1)
        setMoneyBar(("$%s / $%s"):format(fmt(total), fmt(CFG.TARGET_MONEY)), ratio)
    end
    setBaitBar(("%d / %d"):format(bait, CFG.BAIT_COUNT), bait / math.max(CFG.BAIT_COUNT, 1))

    local info = PHASES[phase] or PHASES.IDLE
    local text, color = info[1], info[2]
    if not running then
        text, color = "⏸ หยุดชั่วคราว", C.MUTED
    elseif phase == "FISH" and curZone then
        text = "🎣 ตกปลา · " .. curZone.name
    end
    phaseLabel.Text = text
    phaseLabel.TextColor3 = color
    mainStroke.Color = color
    avatarStroke.Color = color
    pauseBtn.Text = running and "⏸" or "▶"

    cfgLabel.Text = ("⚙ เป้าหมาย $%s  •  ฝากที่ $%s  •  เหยื่อ %d  •  เดิน %d")
        :format(fmt(CFG.TARGET_MONEY), fmt(CFG.DEPOSIT_AT), CFG.BAIT_COUNT, CFG.SPEED)
    afkLabel.Text = afkPings > 0 and ("🛡 Anti-AFK: ON (กันแล้ว %d)"):format(afkPings) or "🛡 Anti-AFK: ON"
    local up = os.time() - startClock
    uptimeLabel.Text = ("⏱ %02d:%02d:%02d"):format(math.floor(up / 3600), math.floor(up / 60) % 60, up % 60)
end

task.spawn(function()
    while alive() do
        pcall(refresh)
        task.wait(0.5)
    end
    if blur then pcall(function() blur:Destroy() end) end
    if gui then gui:Destroy() end
end)

