local function resolve(...)
    local obj = workspace
    for _, n in ipairs({ ... }) do
        if type(n) == "number" then obj = obj:GetChildren()[n] else obj = obj:FindFirstChild(n) end
        if not obj then return nil end
    end
    return obj
end

local function getShiftObj()
    return resolve("Map", "Tiles", "ShoppingTile", "SteakHouse", "Interior", "SteakHouseBeacon", "TouchPart", "MD_CookShift")
end

local function getFridgeObj()
    local interior = resolve("Map", "Tiles", "ShoppingTile", "SteakHouse", "Interior")
    if not interior then return nil end
    local fridge = interior:FindFirstChild("Fridge")
    if not fridge then return nil end
    local base = fridge:FindFirstChild("Base")
    if base then return base:FindFirstChild("MD_CookFridge") or base end
    for _, d in pairs(fridge:GetDescendants()) do
        if d.Name == "MD_CookFridge" then return d end
    end
    return nil
end

local function objPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, cf = pcall(function() return obj:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    local par = obj.Parent
    while par and par ~= workspace do
        if par:IsA("BasePart") then return par.Position end
        if par:IsA("Model") then
            local ok, cf = pcall(function() return par:GetPivot() end)
            if ok and cf then return cf.Position end
        end
        par = par.Parent
    end
    return nil
end

local function getGrillObj()
    local interior = resolve("Map", "Tiles", "ShoppingTile", "SteakHouse", "Interior")
    if not interior then return nil end
    local candidates = {}
    for _, d in ipairs(interior:GetDescendants()) do
        if d.Name == "MD_CookGrill" then
            table.insert(candidates, d)
        elseif d.Name == "GrillArea" and not d:FindFirstChild("MD_CookGrill", true) then
            table.insert(candidates, d)
        end
    end
    local best, bestDist
    for _, c in ipairs(candidates) do
        local pos = objPos(c)
        if pos then
            local dist = (pos - P.COOK_GRILL).Magnitude
            if not bestDist or dist < bestDist then best, bestDist = c, dist end
        end
    end
    if best then return best, bestDist end
    local c65 = interior:GetChildren()[65]
    local ga = c65 and c65:FindFirstChild("GrillArea")
    if ga then return ga:FindFirstChild("MD_CookGrill") or ga end
    return nil
end

local function prepPrompt(p)
    pcall(function()
        p.Enabled = true
        p.RequiresLineOfSight = false
        p.HoldDuration = 0
        if p.MaxActivationDistance < 30 then p.MaxActivationDistance = 30 end
    end)
end

local function findTouchPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
    local inner = obj:FindFirstChildWhichIsA("BasePart", true)
    if inner then return inner end
    local par = obj.Parent
    if par and par:IsA("BasePart") then return par end
    if par and par:IsA("Model") then return par.PrimaryPart or par:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end

-- ⭐ interact ที่มี label บอกว่ากดอะไร (ปรับปรุงจากเวอร์ชันฟิกบัค)
local function interact(obj, label)
    if not obj then
        print("[Interact]", label or "?", "= nil")
        return false
    end
    print(("[Interact] %s → %s [%s]"):format(label or "?", obj:GetFullName(), obj.ClassName))
    local handled = false
    if obj:IsA("ProximityPrompt") then
        prepPrompt(obj); pcall(fireproximityprompt, obj); handled = true
    elseif obj:IsA("ClickDetector") then
        pcall(fireclickdetector, obj); handled = true
    elseif obj:IsA("RemoteEvent") then
        for _, a in ipairs({ "Start", "Accept", "Begin", "Open", "Trigger" }) do
            pcall(function() obj:FireServer(a) end)
        end
        pcall(function() obj:FireServer() end)
        handled = true
    end
    for _, d in pairs(obj:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            prepPrompt(d); pcall(fireproximityprompt, d); handled = true
        elseif d:IsA("ClickDetector") then
            pcall(fireclickdetector, d); handled = true
        end
    end
    if hasTouchInterest then
        local tp = findTouchPart(obj)
        local hrp = getHRP()
        if tp and hrp then
            pcall(function() firetouchinterest(hrp, tp, 0) end)
            task.wait(0.05)
            pcall(function() firetouchinterest(hrp, tp, 1) end)
            handled = true
        end
    end
    return handled
end

local function pressShiftOnce()
    local obj = getShiftObj()
    if not obj then
        print("[AutoFish] ❌ ไม่เจอ MD_CookShift")
        return false
    end
    print(("[AutoFish] กดรับงาน → %s [%s]"):format(obj:GetFullName(), obj.ClassName))
    local prompt = obj:IsA("ProximityPrompt") and obj or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        pcall(function() prompt.Enabled = true end)
        pcall(fireproximityprompt, prompt)
        return true
    end
    local cd = obj:IsA("ClickDetector") and obj or obj:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then pcall(fireclickdetector, cd); return true end
    local part = obj:IsA("BasePart") and obj or obj.Parent
    local hrp = getHRP()
    if hasTouchInterest and part and part:IsA("BasePart") and hrp then
        pcall(function() firetouchinterest(hrp, part, 0) end)
        task.wait(0.05)
        pcall(function() firetouchinterest(hrp, part, 1) end)
        return true
    end
    return false
end

onAccepted = function()
    notify("✅ รับงานสำเร็จ", FEEDBACK_ACCEPT, 3)
    setStatus("✅ " .. FEEDBACK_ACCEPT, Color3.fromRGB(0, 255, 120))
end

local function stepAccept()
    if shiftStarted then return true end
    setStatus("🚶 ไปจุดรับงาน (speed " .. CFG.SPEED_ACCEPT .. ")")
    tweenWalk(P.COOK_ACCEPT, CFG.SPEED_ACCEPT)
    task.wait(0.3)
    setStatus("🔵 กดรับงาน (ครั้งเดียว)...")
    pressShiftOnce()
    local t = 0
    while running and alive() and not shiftStarted and t < 4 do
        task.wait(0.1); t = t + 0.1
    end
    if not shiftStarted then
        setStatus("⚠️ server ยังไม่ตอบ จะลองใหม่", Color3.fromRGB(255, 200, 80))
    end
    return shiftStarted
end

local function stepFridge()
    setStatus("🚶 ไปตู้เย็น")
    tweenWalk(P.COOK_FRIDGE, CFG.SPEED)
    task.wait(0.3)
    setStatus("🧊 กด MD_CookFridge")
    for i = 1, 5 do
        if not running then return end
        interact(getFridgeObj(), "MD_CookFridge")
        task.wait(0.4)
    end
    task.wait(0.4)
end

local function stepGrill()
    setStatus("🚶 ไปเตาย่าง")
    tweenWalk(P.COOK_GRILL, CFG.SPEED)
    task.wait(0.3)
    local hrp = getHRP()

    local grill, gdist = getGrillObj()
    if grill then
        print(("[AutoFish] เตาที่เลือก: %s [%s] ห่าง POS_GRILL %.1f studs"):format(grill:GetFullName(), grill.ClassName, gdist or -1))
        if gdist and gdist > 20 then
            warn("[AutoFish] ⚠️ เตาที่เจออยู่ไกลจาก POS_GRILL มาก ตรวจพิกัดเตาอีกที")
        end
    else
        warn("[AutoFish] ❌ ไม่เจอเตาเลย")
    end

    setStatus("🔥 กด MD_CookGrill")
    if hrp then
        for i = 1, 4 do
            if not running then return end
            pcall(function() hrp.CFrame = CFrame.new(P.COOK_GRILL + Vector3.new(0, 0, 1.5)) end)
            task.wait(0.15)
            pcall(function() hrp.CFrame = CFrame.new(P.COOK_GRILL + Vector3.new(0, 0, -1.5)) end)
            task.wait(0.15)
            if not grill or not grill.Parent then grill = getGrillObj() end
            interact(grill, "MD_CookGrill")
            task.wait(0.2)
        end
    end
    task.wait(0.5)
end

local function stepCook()
    setStatus("🚶 กลับไปรอหน้าตู้เย็น")
    tweenWalk(P.COOK_FRIDGE, CFG.SPEED)
    for i = CFG.WAIT_BEFORE_REMOTE, 1, -1 do
        if not running then return end
        setStatus(("⏳ รอหน้าตู้เย็น %d วิ ก่อนยิงรีโมท..."):format(i), Color3.fromRGB(255, 200, 80))
        task.wait(1)
    end
    setStatus("🔥 Finish (ยิง MD_CookRemote)")
    pcall(function() if CookRemote then CookRemote:FireServer("Finish") end end)
    task.wait(0.2)
    for _, a in ipairs({ "finish_grilling_2", "Finish", "finish" }) do
        pcall(function() if CookRemote then CookRemote:FireServer(a) end end)
    end
    task.wait(0.3)
    pcall(function()
        if firesignal and CookRemote then firesignal(CookRemote.OnClientEvent, "Finished", "Perfect!", 160, 26) end
        if firesignal and CashFX then firesignal(CashFX.OnClientEvent, "Pickup", 160) end
    end)
    task.wait(CFG.AFTER_FINISH_WAIT)
end

local function cookOnce()
    if not shiftStarted then
        if not stepAccept() then task.wait(1); return end
    end
    if not running then return end
    stepFridge(); if not running then return end
    stepGrill();  if not running then return end
    stepCook()
end

