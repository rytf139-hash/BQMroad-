-- ฝากเงินสดเข้าธนาคารก่อน (กันเงินหาย) แล้วรีตัวละครด้วยรีโมทของเกม
local function resetCharacter(reason)
    setStatus("♻️ " .. reason .. " → ฝากเงินแล้วรีตัวละคร", Color3.fromRGB(255, 160, 100))
    local cash = getCash()
    if cash > 0 then
        goATM()
        atmDeposit(cash)
        waitFor(function() return getCash() < cash end, 3)
    end

    local old = player.Character
    local function respawned()
        local c = player.Character
        return c and c ~= old and c:FindFirstChild("HumanoidRootPart") ~= nil
    end

    -- 1) รีตัว (MD_DownedSystem.Reset) ถ้าไม่มีรีโมทใช้ Health = 0
    if ResetRemote then
        pcall(function() ResetRemote:FireServer() end)
    else
        local hum = old and old:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.Health = 0 end) end
    end

    -- 2) กดเกิด (MD_DownedSystem.Respawn) ย้ำเป็นระยะจนกว่าจะเกิดใหม่
    local t = 0
    while t < 20 and alive() and not respawned() do
        task.wait(0.5); t = t + 0.5
        if RespawnRemote and (t == 1.5 or t == 4 or t == 8 or t == 12) then
            pcall(function() RespawnRemote:FireServer() end)
        end
        if t == 6 and not respawned() then
            local c = player.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.Health = 0 end) end
        end
    end
    lastSpawn = tick()
    task.wait(2)
end

-- ซื้อไม่สำเร็จ: ขยายเวลายืนรอที่ร้าน, ครบ 2 ครั้งติดรีตัวละคร, แล้วรีเช็กสถานะ (ไม่หยุดทำงาน)
local function failPurchase(reason)
    purchaseFailStreak = purchaseFailStreak + 1
    local streak = purchaseFailStreak
    CFG.SHOP_WAIT = math.min(CFG.SHOP_WAIT + 1, 10)
    warn(("[AutoFish] ❌ %s (ครั้งที่ %d) ยืนรอที่ร้านเพิ่มเป็น %d วิ"):format(reason, streak, CFG.SHOP_WAIT))
    if streak >= 2 then
        purchaseFailStreak = 0
        resetCharacter(reason)
    end
    resyncState(reason, math.min(3 * streak, 15))
end

-- ยิงซื้อเหยื่อ (ต้องยืนที่ร้านแล้ว) คืน true ถ้าซื้อสำเร็จจริง
local function buyBaitAtShop(n)
    local cashBefore = getCash()
    local baitBefore = getBaitCount()
    setStatus(("🛒 ซื้อเหยื่อ %d อัน (มี %d)"):format(n, baitBefore))
    pcall(function() RentalRemote:FireServer("BuyFishing", CFG.BAIT_ID, n) end)

    -- รอให้เหยื่อเข้ากระเป๋า (สูงสุด 5 วิ)
    if waitFor(function() return getBaitCount() > baitBefore end, 5) then
        baitBlind = 0
        return true
    end
    -- เหยื่อไม่เพิ่ม: ดูว่าเงินลดไหม
    if cashBefore - getCash() >= CFG.BAIT_PRICE then
        baitBlind = n
        warn("[AutoFish] ซื้อเหยื่อแล้ว (เงินลด) แต่นับเหยื่อในกระเป๋าไม่เจอ ใช้จำนวนที่ซื้อแทน")
        notify("⚠️ นับเหยื่อไม่เจอ", "ใช้จำนวนที่ซื้อแทน", 5)
        return true
    end
    return false
end

local function buyRodAndBait()
    setStatus("🔎 เช็กเบ็ด / เหยื่อ / เงิน ก่อนซื้อ")
    printCheck("ก่อนซื้อ")
    task.wait(0.5)
    -- 1) ถอนเงินให้เงินสดถึงเป้า และเช็กว่าถอนได้จริงก่อนไปต่อ
    if getCash() < CFG.TARGET_MONEY and not hasRod() then
        goATM()
        if not ensureCash(CFG.TARGET_MONEY) then
            resyncState("ถอนเงินไม่สำเร็จ", 3)
            return
        end
    end

    -- 2) ไปร้าน ยืนรอ แล้วเช็กเงินอีกรอบก่อนซื้อ
    goShop()
    stayAtShop() -- server ต้องการให้ยืนที่ร้านสักพักก่อนซื้อ
    if not hasRod() then
        if getCash() < CFG.TARGET_MONEY then
            resyncState("เงินสดไม่พอก่อนซื้อเบ็ด", 2)
            return
        end
        if not tryBuyRod() then
            failPurchase("ซื้อเบ็ดไม่สำเร็จ")
            return
        end
    end
    waitFor(hasRod, 3)
    rodOwned = true
    rodBlind = not hasRod()      -- ถ้าเงินลดแต่หาเบ็ดไม่เจอ ให้เชื่อธง ไม่ซื้อซ้ำ
    purchaseFailStreak = 0
    notify("✅ ได้เบ็ดแล้ว", "ตรวจเหยื่อและเริ่มฟามเลเวล", 3)

    -- 3) ซื้อเหยื่อเฉพาะที่ขาด (ถ้ามีครบ/เกิน ไม่ซื้อ)
    local have = getBaitCount()
    local want = CFG.BAIT_COUNT - have
    if want > 0 then
        local canBuy = math.min(want, math.floor(getCash() / CFG.BAIT_PRICE))
        if canBuy > 0 then
            if not buyBaitAtShop(canBuy) then
                failPurchase("ซื้อเหยื่อไม่สำเร็จ")
            end
        end
    else
        setStatus(("🪱 มีเหยื่อ %d อัน พอแล้ว ไม่ซื้อเพิ่ม"):format(have))
    end

    needSell = true
    -- ยังไม่ถือเบ็ดตรงนี้ (เกมจะเก็บเบ็ดเอง) ไปถือตอนถึงจุดตกปลา
end

local function sellFish()
    setStatus("🐟 ไปขายปลา")
    tweenWalk(P.SELL, CFG.SPEED)
    task.wait(0.4)
    for i = CFG.SELL_WAIT, 1, -1 do
        if not running or not alive() then return false end
        setStatus(("🐟 ยืนรอที่จุดขาย %d วิ ก่อนขาย..."):format(i), Color3.fromRGB(255, 200, 80))
        task.wait(1)
    end
    setStatus("🐟 ขายปลาทั้งหมด")
    pcall(function() FishingRemote:FireServer("SellAll") end)
    task.wait(1.5)
    return true
end

local function baitAffordable()
    local missing = CFG.BAIT_COUNT - getBaitCount()
    return math.min(missing, math.floor(totalMoney() / CFG.BAIT_PRICE))
end

local function buyBait(n)
    -- มีเหยื่อครบ/เกินแล้ว ไม่ต้องซื้อ
    if getBaitCount() >= CFG.BAIT_COUNT then
        setStatus("🪱 เหยื่อพอแล้ว ไม่ซื้อเพิ่ม")
        needSell = true
        return
    end
    setStatus("🔎 เช็กเบ็ด / เหยื่อ / เงิน ก่อนซื้อ")
    printCheck("ก่อนซื้อเหยื่อ")
    goATM()
    local need = n * CFG.BAIT_PRICE
    local cash = getCash()
    if cash > need then
        atmDeposit(cash - need)          -- เหลือไว้ซื้อเหยื่อ ที่เหลือฝาก
    elseif cash < need then
        if not ensureCash(need) then     -- ถอนเพิ่มแล้วเช็กว่าได้เงินจริง
            resyncState("ถอนเงินซื้อเหยื่อไม่สำเร็จ", 3)
            return
        end
    end
    goShop()
    stayAtShop()
    if getCash() < need then
        resyncState("เงินสดไม่พอก่อนซื้อเหยื่อ", 2)
        return
    end

    if buyBaitAtShop(n) then
        purchaseFailStreak = 0
    else
        failPurchase("ซื้อเหยื่อไม่สำเร็จ")
    end
    needSell = true
end

--=====================================================================
--  ตั๋ว PALM ISLAND (ซื้อครั้งเดียวถาวร ที่ร้านเดียวกับเบ็ด)
--=====================================================================
-- สั่งเปิดร้านตกปลา เพื่อให้ server ส่งรายการ + สถานะ owned มาให้ (ต้องยืนอยู่ที่ร้าน)
local function refreshShopData(timeout)
    local since = tick()
    pcall(function() RentalRemote:FireServer("OpenFishing") end)
    return waitFor(function() return shopEventAt >= since end, timeout or 4)
end

-- ไปร้านครั้งเดียวเพื่อถามว่า "มีตั๋วแล้วหรือยัง" (เปิดร้านให้ server ส่งสถานะ)
local ticketCheckTries = 0
local function checkTicketAtShop()
    ticketCheckTries = ticketCheckTries + 1
    setStatus("🔎 ไปร้านเช็กว่ามีตั๋ว Palm Island แล้วหรือยัง", Color3.fromRGB(130, 195, 250))
    goShop()
    task.wait(1)
    local got = refreshShopData(4)
    if not got then
        stayAtShop()
        got = refreshShopData(5)
    end

    if hasPalmTicket() then
        ticketChecked = true
        notify("🎫 มีตั๋วแล้ว", "ไปตกที่ Palm Island (" .. ticketSource .. ")", 4)
    elseif ticketListed then
        ticketChecked = true
        notify("🎫 ยังไม่มีตั๋ว", "ร้านบอกว่ายังไม่ได้ซื้อ", 4)
    elseif ticketCheckTries >= 2 then
        ticketChecked = true
        warn("[AutoFish] ⚠️ ร้านไม่ส่งข้อมูล " .. CFG.TICKET_ID .. " มา ถ้าซื้อตั๋วแล้วจริง ให้ตั้ง HAS_TICKET = true")
        notify("⚠️ เช็กตั๋วไม่ได้", "ถ้ามีตั๋วแล้ว ตั้ง HAS_TICKET = true", 6)
    end
end

local function tryBuyTicket()
    for attempt = 1, 4 do
        if not (running or manualTest) or not alive() then return false end
        local before = getCash()
        setStatus(("🎫 ซื้อตั๋ว Palm Island (ครั้งที่ %d/4)"):format(attempt), Color3.fromRGB(255, 208, 90))
        pcall(function() RentalRemote:FireServer("BuyFishing", CFG.TICKET_ID) end)
        task.wait(1.5)
        -- สำเร็จถ้าเจอตั๋ว หรือเงินสดลดลงเกือบเท่าราคาตั๋ว
        if hasPalmTicket() or getCash() <= before - math.floor(CFG.TICKET_PRICE * 0.9) then
            ticketOwned = true
            if ticketSource == "" then ticketSource = "bought" end
            return true
        end
        setStatus("⏳ server ให้รอที่ร้านเพิ่ม...", Color3.fromRGB(255, 200, 80))
        task.wait(3)
    end
    return false
end

local function buyPalmTicket()
    setStatus("🔎 เช็กตั๋ว / เงิน ก่อนซื้อตั๋ว Palm Island")
    printCheck("ก่อนซื้อตั๋ว")
    task.wait(0.5)
    if hasPalmTicket() then return end

    -- 1) ถอนเงินจากธนาคารให้เงินสดพอซื้อตั๋ว
    if getCash() < CFG.TICKET_PRICE then
        goATM()
        if not ensureCash(CFG.TICKET_PRICE) then
            resyncState("ถอนเงินซื้อตั๋วไม่สำเร็จ", 3)
            return
        end
    end

    -- 2) ไปร้านเดียวกับที่ซื้อเบ็ด ยืนรอ แล้วซื้อตั๋ว
    goShop()
    stayAtShop()
    -- ถามร้านอีกรอบก่อนซื้อ: ถ้าซื้อไปแล้วจะไม่ซื้อซ้ำ
    refreshShopData(4)
    if hasPalmTicket() then
        notify("🎫 มีตั๋วอยู่แล้ว", "ไม่ต้องซื้อซ้ำ (" .. ticketSource .. ")", 4)
        return
    end
    if getCash() < CFG.TICKET_PRICE then
        resyncState("เงินสดไม่พอก่อนซื้อตั๋ว", 2)
        return
    end
    if not tryBuyTicket() then
        failPurchase("ซื้อตั๋ว Palm Island ไม่สำเร็จ")
        return
    end

    purchaseFailStreak = 0
    notify("🎫 ได้ตั๋วแล้ว", "ไปตกปลาที่ Palm Island", 4)
    needSell = true
end

--=====================================================================
--  FISHING
--=====================================================================
local function getServerTime()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    if ok and typeof(t) == "number" then return t end
    return tick()
end

local function computeReelTime(data, minDelay)
    minDelay = minDelay or 0.15
    local now = getServerTime()
    local n = math.ceil((now + minDelay - data.start) / data.period - data.center)
    if n < 0 then n = 0 end
    return data.start + (data.center + n) * data.period
end

local function fishRound(zone)
    local required, reelsSent = nil, 0
    local lastActivity = tick()
    local active = true
    local startT = tick()
    local endEarly, failMsg, gotWait = false, nil, false

    local conn = FishingRemote.OnClientEvent:Connect(function(...)
        if not running or not active then return end
        local args = { ... }
        local ev = args[1]
        if ev == "Bite" then
            local data = args[2]
            if type(data) ~= "table" then return end
            required = data.required
            gotWait = true
            lastActivity = tick()
            setStatus(string.format("🎣 Bite! รอบ %s/%s", tostring(data.round), tostring(required)), Color3.fromRGB(255, 220, 100))
            local targetTime = computeReelTime(data, 0.15)
            task.spawn(function()
                local waitSec = targetTime - getServerTime()
                if waitSec > 0 then task.wait(waitSec) end
                if not (running and active) then return end
                FishingRemote:FireServer("Reel", { at = getServerTime(), round = data.round })
                reelsSent = reelsSent + 1
                setStatus(string.format("🎣 ส่ง Reel (%d/%d)", reelsSent, required or 0), Color3.fromRGB(120, 220, 120))
            end)
        elseif ev == "Wait" then
            gotWait = true
            lastActivity = tick()
        elseif ev == "End" then
            -- server แจ้งจบ พร้อมข้อความเหตุผล (เช่น โยนที่นี่ไม่ได้ / ไม่มีเหยื่อ / ต้องมีตั๋ว)
            local msg = args[2]
            if type(msg) == "string" and msg ~= "" then
                lastFishMsg = msg
                print("[AutoFish] 📢 server:", msg)
            end
            if not required then          -- จบก่อนมีปลากัด = โยนไม่สำเร็จ
                endEarly = true
                failMsg = (type(msg) == "string" and msg ~= "") and msg or "(server จบโดยไม่มีข้อความ)"
            end
        end
    end)

    setStatus("🎣 เหวี่ยงเบ็ด (" .. zone.name .. ")", Color3.fromRGB(255, 220, 100))
    FishingRemote:FireServer("Cast", zone.cast)

    local success = false
    local lostAt = nil
    while running and alive() and active do
        task.wait(0.25)
        if not heldRod() then
            lostAt = lostAt or tick()
            if tick() - lostAt > 2 then break end
        else
            lostAt = nil
        end
        if required and reelsSent >= required then
            task.wait(0.6)
            success = true
            break
        end
        if endEarly then break end
        if not gotWait and not required and tick() - startT > 6 then
            failMsg = failMsg or "server ไม่ตอบคำสั่งโยน (จุดโยนอาจไม่ใช่น้ำ หรือไม่มีสิทธิ์ตกที่นี่)"
            lastFishMsg = failMsg
            break
        end
        if tick() - lastActivity > 12 then break end
    end
    active = false
    conn:Disconnect()

    if success then
        catchCount = catchCount + 1
        if baitBlind > 0 then baitBlind = baitBlind - 1 end
        setStatus(string.format("🐟 ได้ปลา! (%d) ใช้เวลา %.1fs", catchCount, tick() - startT), Color3.fromRGB(120, 255, 120))
    else
        if failMsg then
            setStatus(("⚠️ โยนเบ็ดที่ %s ไม่สำเร็จ: %s"):format(zone.name, failMsg), Color3.fromRGB(255, 120, 120))
            notify("⚠️ โยนเบ็ดไม่สำเร็จ", failMsg, 6)
            task.wait(3)   -- ให้เวลาอ่านข้อความ และกันยิง Cast รัวๆ
        else
            setStatus("⌛ หมดเวลา ลองเหวี่ยงใหม่", Color3.fromRGB(255, 180, 100))
        end
    end
    task.wait(1)
    return success
end

--=====================================================================
--  MAIN LOGIC
--=====================================================================
local function step()
    -- รอให้ตัวละครเกิดและกระเป๋าโหลดเสร็จก่อนตัดสินใจ (กันเช็กเบ็ด/เหยื่อผิดตอนเพิ่งเกิด)
    if tick() - lastSpawn < 4 then task.wait(1); return end

    -- ---------- เช็กเบ็ดทุกรอบ ----------
    if hasRod() then
        rodOwned = true
        rodBlind = false
    elseif rodOwned and not rodBlind then
        -- เคยมีเบ็ดแต่ตอนนี้หาไม่เจอ: ซิงก์กระเป๋าแล้วเช็กซ้ำก่อนสรุปว่าเบ็ดหาย
        resyncState("หาเบ็ดไม่เจอ ตรวจกระเป๋าใหม่")
        if not hasRod() then
            warn("[AutoFish] ❌ เบ็ดหาย → ต้องซื้อเบ็ดใหม่")
            rodOwned = false
        end
        return
    end

    -- ---------- เฟส A: ไม่มีเบ็ด -> ฟามเงินให้ครบ แล้วซื้อเบ็ด+เหยื่อ ----------
    if not rodOwned then
        if totalMoney() < CFG.TARGET_MONEY then
            phase = "COOK"
            setStatus(string.format("🍳 ฟามเงิน %d / %d", totalMoney(), CFG.TARGET_MONEY))
            cookOnce()
            if running and getCash() >= CFG.DEPOSIT_AT and totalMoney() < CFG.TARGET_MONEY then
                depositTrip()
            end
            return
        else
            phase = "BUY"
            buyRodAndBait()
            return
        end
    end

    -- ---------- เฟส B: มีเบ็ดแล้ว ----------
    if getEffectiveBait() <= 0 then
        phase = "RESUPPLY"
        if needSell then
            if sellFish() then needSell = false else return end
        end
        local n = baitAffordable()
        if n < 1 then
            phase = "COOK"
            setStatus("🍳 เงินไม่พอซื้อเหยื่อ ไปฟามเงิน")
            cookOnce()
            return
        end
        buyBait(n)
        return
    end

    -- ---------- เฟส C: ตั๋ว Palm Island ----------
    -- 1) ยังไม่รู้สถานะตั๋ว -> ไปร้านเปิดหน้าร้านให้ server ส่งสถานะ (owned) มาก่อน (ทำครั้งเดียว)
    if not ticketChecked then
        if hasPalmTicket() then
            ticketChecked = true
        else
            phase = "CHECK"
            checkTicketAtShop()
            return
        end
    end
    -- 2) เลเวล 60+ ยังไม่มีตั๋ว: เงินรวม (สด+ธนาคาร) ถึง 2,200,000 -> ถอนไปซื้อตั๋ว
    --    ยังไม่ถึง -> ฟามต่อ (ตกปลาที่โซนปกติ แล้วเก็บเงินจากการขายปลา)
    if getFishLevel() >= CFG.PALM_LEVEL and not hasPalmTicket() then
        if totalMoney() >= CFG.TICKET_MONEY then
            phase = "TICKET"
            buyPalmTicket()
            return
        end
    end

    local zone = pickZone(getFishLevel())
    curZone = zone
    phase = "FISH"
    local hrp = getHRP()
    if not hrp then task.wait(1); return end
    if (hrp.Position - zone.stand).Magnitude > 25 then
        setStatus("🚶 ไป " .. zone.name)
        tweenWalk(zone.stand, CFG.SPEED)
        task.wait(0.4)
    end
    -- ถือเบ็ดตอนถึงจุดตกปลา และเช็กว่าถืออยู่ก่อนโยนทุกครั้ง
    if not ensureRodHeld() and rodFailStreak < 3 then
        setStatus("⚠️ ถือเบ็ดไม่สำเร็จ ลองใหม่", Color3.fromRGB(255, 180, 100))
        task.wait(2)
        return
    end
    if fishRound(zone) then
        timeoutStreak = 0
    else
        timeoutStreak = timeoutStreak + 1
        if timeoutStreak >= 6 then
            timeoutStreak = 0
            resyncState("ตกไม่ติดต่อเนื่อง 6 รอบ")
        end
    end
end

local function mainLoop()
    while running and alive() do
        local ok, err = pcall(step)
        if not ok then
            warn("[AutoFish] Error:", err)
            task.wait(1)
        end
        task.wait(0.1)
    end
end

--=====================================================================
--  ANTI-SIT (กันนั่ง / กันติดเก้าอี้)
--=====================================================================
local antiSitEnabled = true
local lastSitWarn = 0

local function isSeat(p)
    return p and (p:IsA("Seat") or p:IsA("VehicleSeat"))
end

local function sitWarn()
    if tick() - lastSitWarn < 3 then return end
    lastSitWarn = tick()
    notify("🚫 กันนั่ง", "เซิร์ฟเวอร์นี้ไม่อนุญาตให้นั่งเก้าอี้", 2)
end

local function forceStand(character, humanoid)
    local seat = humanoid.SeatPart
    if seat then
        for _, v in ipairs(seat:GetChildren()) do
            if v:IsA("Weld") or v:IsA("Motor6D") or v:IsA("WeldConstraint") then
                if v.Name == "SeatWeld" or v:IsA("Weld") then pcall(function() v:Destroy() end) end
            end
        end
    end
    for _, v in ipairs(character:GetChildren()) do
        if v:IsA("Weld") or v:IsA("Motor6D") then
            if isSeat(v.Part0) or isSeat(v.Part1) then pcall(function() v:Destroy() end) end
        end
    end
    humanoid.Sit = false
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
end

local function setupAntiSit(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    character.ChildAdded:Connect(function(child)
        if not antiSitEnabled or not alive() then return end
        if child:IsA("Weld") or child:IsA("Motor6D") then
            task.spawn(function()
                task.wait()
                if isSeat(child.Part0) or isSeat(child.Part1) then
                    pcall(function() child:Destroy() end)
                    humanoid.Sit = false
                    sitWarn()
                end
            end)
        end
    end)

    humanoid.StateChanged:Connect(function(_, newState)
        if not antiSitEnabled or not alive() then return end
        if newState == Enum.HumanoidStateType.Seated then
            forceStand(character, humanoid)
            sitWarn()
        end
    end)

    task.spawn(function()
        while alive() and character and character.Parent and humanoid and humanoid.Parent do
            if antiSitEnabled and (humanoid.Sit or humanoid.SeatPart) then
                forceStand(character, humanoid)
                sitWarn()
            end
            task.wait(0.1)
        end
    end)
end

if player.Character then task.spawn(setupAntiSit, player.Character) end

player.CharacterAdded:Connect(function(newChar)
    if activeBeam and activeBeam.Parent then activeBeam:Destroy() end
    if activeTween then pcall(function() activeTween:Cancel() end) end
    shiftStarted = false
    lastEquipTry = 0
    lastSpawn = tick()
    if alive() then task.spawn(setupAntiSit, newChar) end
end)

