local function getFishCount()
    local n = 0
    for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool")
                    and t:GetAttribute("MD_FarmItem") == true
                    and t.Name ~= CFG.ROD_ID
                    and not t.Name:lower():find(CFG.BAIT_MATCH, 1, true) then
                    n = n + (tonumber(t:GetAttribute("MD_StackCount")) or 1)
                end
            end
        end
    end
    return n
end

local function fmt(n)
    local str = tostring(math.floor(n))
    local left, num, right = str:match("^([^%d]*%d)(%d*)(.-)$")
    if not left then return str end
    local rev = num:reverse():gsub("(%d%d%d)", "%1,")
    return left .. rev:reverse() .. right
end

