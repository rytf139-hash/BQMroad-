    tweenWalk(P.SHOP, CFG.SPEED)
    task.wait(0.4)
end

local function stayAtShop()
    for i = CFG.SHOP_WAIT, 1, -1 do
        if not (running or manualTest) or not alive() then return end
        setStatus(("🛒 ยืนรอที่ร้าน %d วิ ก่อนซื้อ..."):format(i), Color3.fromRGB(255, 200, 80))
        task.wait(1)
    end
end

local function equipRod()
    if heldRod() then return true end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = findTool(function(t) return t.Name == CFG.ROD_ID end)
    if not tool or not char or not hum then return false end
    setStatus("🎣 ถือเบ็ด")
    if tool.Parent ~= char then
        pcall(function() hum:EquipTool(tool) end)
        task.wait(0.4)
    end
    pcall(function() RentalRemote:FireServer("EquipFarm", char:FindFirstChild(CFG.ROD_ID) or tool) end)
    task.wait(0.4)
    if not heldRod() then
        pcall(function() ItemsEvent:FireServer("SelectSlot", CFG.ROD_SLOT) end)
        task.wait(0.5)
    end
    return heldRod()
end

local rodFailStreak = 0
local function ensureRodHeld()
    for _ = 1, 3 do
        if heldRod() then rodFailStreak = 0; return true end
        equipRod()
        if heldRod() then rodFailStreak = 0; return true end
        task.wait(0.5)
    end
    rodFailStreak = rodFailStreak + 1
    return false
end

local function tryBuyRod()
    for attempt = 1, 4 do
        if not (running or manualTest) or not alive() then return false end
        local before = getCash()
        setStatus(("🛒 ซื้อเบ็ด (ครั้งที่ %d/4)"):format(attempt))
        pcall(function() RentalRemote:FireServer("BuyFishing", CFG.ROD_ID) end)
        task.wait(1.5)
        if hasRod() or getCash() <= before - 1000 then return true end
        setStatus("⏳ server ให้รอที่ร้านเพิ่ม...", Color3.fromRGB(255, 200, 80))
        task.wait(3)
    end
    return false
end

local function buyRodAndBait()
    if getCash() < CFG.TARGET_MONEY then
        goATM()
        local cash = getCash()
        if cash > 0 then atmDeposit(cash) end
        if getBank() < CFG.TARGET_MONEY then
            setStatus("⚠️ เงินในธนาคารไม่ถึง " .. CFG.TARGET_MONEY, Color3.fromRGB(255, 180, 100))
            task.wait(2)
            return
        end
        atmWithdraw(CFG.TARGET_MONEY)
    end

    goShop()
    stayAtShop()
    if not hasRod() then
        if not tryBuyRod() then
            setStatus("⚠️ ซื้อเบ็ดไม่สำเร็จ ดู Console (F9) แล้วลองใหม่", Color3.fromRGB(255, 180, 100))
            task.wait(2)
            return
        end
    end
    rodOwned = true
    notify("✅ ได้เบ็ดแล้ว", "ตรวจเหยื่อและเริ่มฟามเลเวล", 3)

    local have = getBaitCount()
    local want = CFG.BAIT_COUNT - have
    if want > 0 then
        local canBuy = math.min(want, math.floor(getCash() / CFG.BAIT_PRICE))
        if canBuy > 0 then
            setStatus(("🛒 ซื้อเหยื่อ %d อัน (มี %d)"):format(canBuy, have))
            pcall(function() RentalRemote:FireServer("BuyFishing", CFG.BAIT_ID, canBuy) end)
            task.wait(1.5)
        end
    else
        setStatus(("🪱 มีเหยื่อ %d อัน พอแล้ว ไม่ซื้อเพิ่ม"):format(have))
    end

    needSell = true
end

local function sellFish()
    setStatus("🐟 ไปขายปลา")
    tweenWalk(P.SELL, CFG.SPEED)
    task.wait(0.4)
    for i = CFG.SELL_WAIT, 1, -1 do
        if not running or not alive() then return false end
        setStatus(("🐟 ยืนรอที่จุดขาย %d วิ ก่อนขาย..."):format(i), Color3.fromRGB(255, 200, 80))
        task.wait(1)
    end
    setStatus("🐟 ขายปลาทั้งหมด")
    pcall(function() FishingRemote:FireServer("SellAll") end)
    task.wait(1.5)
    return true
end

local function baitAffordable()
    local missing = CFG.BAIT_COUNT - getBaitCount()
    return math.min(missing, math.floor(totalMoney() / CFG.BAIT_PRICE))
end

local function buyBait(n)
    if getBaitCount() >= CFG.BAIT_COUNT then
        setStatus("🪱 เหยื่อพอแล้ว ไม่ซื้อเพิ่ม")
        needSell = true
        return
    end
    goATM()
    local need = n * CFG.BAIT_PRICE
    local cash = getCash()
    if cash > need then
        atmDeposit(cash - need)
    elseif cash < need then
        atmWithdraw(need - cash)
    end
    goShop()
    stayAtShop()
    setStatus("🛒 ซื้อเหยื่อ " .. n .. " อัน")
    pcall(function() RentalRemote:FireServer("BuyFishing", CFG.BAIT_ID, n) end)
    task.wait(1.5)

    if getBaitCount() <= 0 then
        baitFailCount = baitFailCount + 1
        warn("[AutoFish] ซื้อเหยื่อแล้วแต่นับเหยื่อไม่เจอ (" .. baitFailCount .. ")")
        if baitFailCount >= 2 then
            running = false
            notify("⚠️ หยุดเพื่อความปลอดภัย", "นับเหยื่อในตัวไม่เจอ ระบบหยุดเพื่อความปลอดภัย", 8)
            setStatus("⛔ นับเหยื่อไม่เจอ หยุดทำงาน", Color3.fromRGB(255, 100, 100))
        end
    else
        baitFailCount = 0
    end
    needSell = true
end

--=====================================================================
--  FISHING
--=====================================================================
local function getServerTime()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    if ok and typeof(t) == "number" then return t end
    return tick()
end

local function computeReelTime(data, minDelay)
    minDelay = minDelay or 0.15
    local now = getServerTime()
    local n = math.ceil((now + minDelay - data.start) / data.period - data.center)
    if n < 0 then n = 0 end
    return data.start + (data.center + n) * data.period
end

local function fishRound(zone)
    local required, reelsSent = nil, 0
    local lastActivity = tick()
    local active = true
    local startT = tick()

    local conn = FishingRemote.OnClientEvent:Connect(function(...)
        if not running or not active then return end
        local args = { ... }
        local ev = args[1]
        if ev == "Bite" then
            local data = args[2]
            if type(data) ~= "table" then return end
            required = data.required
            lastActivity = tick()
            setStatus(string.format("🎣 Bite! รอบ %s/%s", tostring(data.round), tostring(required)), Color3.fromRGB(255, 220, 100))
            local targetTime = computeReelTime(data, 0.15)
            task.spawn(function()
                local waitSec = targetTime - getServerTime()
                if waitSec > 0 then task.wait(waitSec) end
                if not (running and active) then return end
                FishingRemote:FireServer("Reel", { at = getServerTime(), round = data.round })
                reelsSent = reelsSent + 1
                setStatus(string.format("🎣 ส่ง Reel (%d/%d)", reelsSent, required or 0), Color3.fromRGB(120, 220, 120))
            end)
        elseif ev == "Wait" then
            lastActivity = tick()
        end
    end)

    setStatus("🎣 เหวี่ยงเบ็ด (" .. zone.name .. ")", Color3.fromRGB(255, 220, 100))
    FishingRemote:FireServer("Cast", zone.cast)

    local success = false
    local lostAt = nil
    while running and alive() and active do
        task.wait(0.25)
        if not heldRod() then
            lostAt = lostAt or tick()
            if tick() - lostAt > 2 then break end
        else
            lostAt = nil
        end
        if required and reelsSent >= required then
            task.wait(0.6)
            success = true
            break
        end
        if tick() - lastActivity > 12 then break end
    end
    active = false
    conn:Disconnect()

    if success then
        catchCount = catchCount + 1
        setStatus(string.format("🐟 ได้ปลา! (%d) ใช้เวลา %.1fs", catchCount, tick() - startT), Color3.fromRGB(120, 255, 120))
    else
        setStatus("⌛ หมดเวลา ลองเหวี่ยงใหม่", Color3.fromRGB(255, 180, 100))
    end
    task.wait(1)
    return success
end

--=====================================================================
--  MAIN LOGIC
--=====================================================================
local function step()
    if not rodOwned then
        if hasRod() then
            rodOwned = true
        elseif totalMoney() < CFG.TARGET_MONEY then
            phase = "COOK"
            setStatus(string.format("🍳 ฟามเงิน %d / %d", totalMoney(), CFG.TARGET_MONEY))
            cookOnce()
            if running and getCash() >= CFG.DEPOSIT_AT and totalMoney() < CFG.TARGET_MONEY then
                depositTrip()
            end
            return
        else
            phase = "BUY"
            buyRodAndBait()
            return
        end
    end

    if getBaitCount() <= 0 then
        phase = "RESUPPLY"
        if needSell then
            if sellFish() then needSell = false else return end
        end
        local n = baitAffordable()
        if n < 1 then
            phase = "COOK"
            setStatus("🍳 เงินไม่พอซื้อเหยื่อ ไปฟามเงิน")
            cookOnce()
            return
        end
        buyBait(n)
        return
    end

    local zone = pickZone(getFishLevel())
    curZone = zone
    phase = "FISH"
    local hrp = getHRP()
    if not hrp then task.wait(1); return end
    if (hrp.Position - zone.stand).Magnitude > 25 then
        setStatus("🚶 ไป " .. zone.name)
        tweenWalk(zone.stand, CFG.SPEED)
        task.wait(0.4)
    end
    if not ensureRodHeld() and rodFailStreak < 3 then
        setStatus("⚠️ ถือเบ็ดไม่สำเร็จ ลองใหม่", Color3.fromRGB(255, 180, 100))
        task.wait(2)
        return
    end
    fishRound(zone)
end

local function mainLoop()
    while running and alive() do
        local ok, err = pcall(step)
        if not ok then
            warn("[AutoFish] Error:", err)
            task.wait(1)
        end
        task.wait(0.1)
    end
end

