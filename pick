--  MOVEMENT (Tween)
--=====================================================================
local function showBeam(fromPos, toPos, duration)
    if activeBeam and activeBeam.Parent then activeBeam:Destroy() end
    local dist = (toPos - fromPos).Magnitude
    if dist < 2 then return end
    local part = Instance.new("Part")
    part.Name = "AutoFishGuide"
    part.Anchored = true; part.CanCollide = false
    part.CanQuery = false; part.CanTouch = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 255, 170)
    part.Transparency = 0.35
    part.Size = Vector3.new(0.4, 0.4, dist)
    part.CFrame = CFrame.lookAt((fromPos + toPos) / 2, toPos)
    part.Parent = workspace
    activeBeam = part
    task.delay(duration + 0.5, function()
        if part and part.Parent then part:Destroy() end
    end)
end

local function tweenWalk(targetPos, speed)
    local char = getChar()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = speed end

    local startPos = hrp.Position
    local flatDist = (Vector3.new(startPos.X, 0, startPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
    if flatDist < 2 then
        pcall(function() hrp.CFrame = CFrame.new(targetPos) end)
        return true
    end

    local duration = math.max(flatDist / speed, 0.2)
    showBeam(startPos, targetPos, duration)

    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.new(targetPos) })
    local done = false
    local conn = activeTween.Completed:Connect(function() done = true end)
    activeTween:Play()

    local t = 0
    while not done and t < duration + 5 do
        task.wait(0.05); t = t + 0.05
        if not running or not alive() then pcall(function() activeTween:Cancel() end) break end
        if not hrp or not hrp.Parent then break end
    end
    conn:Disconnect(); activeTween = nil
    if hrp and hrp.Parent then pcall(function() hrp.CFrame = CFrame.new(targetPos) end) end
    return true
end

