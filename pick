-- อ่านการ์ดตั๋วในหน้าร้าน: PlayerGui.MD_HouseRentalGui.MD_JackFarmShop.Catalogue.PalmIslandTicket
-- การ์ดมีครบทุกไอเทมที่ร้านขาย "ไม่ได้แปลว่าซื้อแล้ว" ดูจากป้ายราคาแทน:
--   ซื้อแล้ว = "OWNED"   /  ยังไม่ซื้อ = "$ราคา" หรือ "LV xx"
-- คืนค่า: true = ซื้อแล้ว, false = ยังไม่ซื้อ, nil = ไม่มีการ์ด (ยังไม่เคยเปิดร้านในเซสชันนี้)
local function ticketCardState()
    local ok, res = pcall(function()
        local pg   = player:FindFirstChild("PlayerGui")
        local gui  = pg and pg:FindFirstChild("MD_HouseRentalGui")
        local shop = gui and gui:FindFirstChild("MD_JackFarmShop")
        local cat  = shop and shop:FindFirstChild("Catalogue")
        local card = cat and cat:FindFirstChild(CFG.TICKET_ID)
        if not card then return nil end
        local price = card:FindFirstChild("Price")
        local txt = price and tostring(price.Text) or ""
        return txt:upper():find("OWNED", 1, true) ~= nil
    end)
    if ok then return res end
    return nil
end

-- เช็กตั๋วในกระเป๋า/มือ: Tool ที่ชื่อตรงกับ TICKET_ID หรือมีทั้งคำว่า palm และ ticket
local function ticketInBag()
    return findTool(function(t)
        local n = t.Name:lower()
        return n == CFG.TICKET_ID:lower() or (n:find("palm", 1, true) ~= nil and n:find("ticket", 1, true) ~= nil)
    end) ~= nil
end

local function hasPalmTicket()
    if ticketOwned then return true end
    if ticketInBag() then
        ticketOwned = true; ticketSource = "bag"
        print("[AutoFish] 🎫 พบตั๋ว Palm Island ในกระเป๋า")
    elseif ticketCardState() == true then
        ticketOwned = true; ticketSource = "card"
        print("[AutoFish] 🎫 การ์ดตั๋วในร้านขึ้นว่า OWNED")
    end
    return ticketOwned
end

local function pickZone(lv)
    -- มีตั๋ว Palm Island แล้ว -> ไปตกที่ Palm Island เลย (ถ้าไม่ได้ตั้ง PALM_NEED_LEVEL)
    if hasPalmTicket() and (not CFG.PALM_NEED_LEVEL or lv >= CFG.PALM_LEVEL) then
        for _, zz in ipairs(ZONES) do
            if zz.ticket then return zz end
        end
    end
    -- ไม่มีตั๋ว -> เลือกโซน 1-3 ตามเลเวล
    local z = ZONES[1]
    for _, zz in ipairs(ZONES) do
        if not zz.ticket and lv >= zz.minLv then z = zz end
    end
    return z
end

