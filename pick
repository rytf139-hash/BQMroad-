local function atmDeposit(amount)
    amount = math.floor(amount)
    if amount <= 0 then return end
    setStatus("🏦 ฝากเงิน $" .. amount, Color3.fromRGB(150, 200, 245))
    pcall(function() ATMRemote:FireServer("Deposit", amount) end)
    task.wait(0.9)
end

local function atmWithdraw(amount)
    amount = math.floor(amount)
    if amount <= 0 then return end
    setStatus("🏦 ถอนเงิน $" .. amount, Color3.fromRGB(150, 200, 245))
    pcall(function() ATMRemote:FireServer("Withdraw", amount) end)
    task.wait(0.9)
end

local function depositTrip()
    goATM()
    atmDeposit(getCash())
end

local function goShop()
